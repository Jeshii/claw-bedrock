[Unit]
Description=claw-bedrock

[Service]
Restart=on-failure
TimeoutStartSec=900
CPUQuota=50%

[Container]
# Pre-built image from GitHub Container Registry:
Image=ghcr.io/jeshii/claw-bedrock:latest
ContainerName=claw-bedrock
PublishPort=4000:4000
PublishPort=8282:8080

# Update these values:
Environment=AWS_PROFILE=your-profile
Environment=AWS_REGION=your-region
Environment=BEDROCK_MANTLE_API_BASE=https://bedrock-mantle.<region>.api.aws/v1
# Environment=OPENROUTER_API_KEY=your-key  # optional
# Environment=OLLAMA_API_BASE=http://your-ollama-host:11434  # optional

# IMPORTANT: ~/.aws must exist (run `aws configure` to create it)
Volume=%h/.aws:/app/.aws:Z

# Optional: mount config.local.yaml for local model overrides (Ollama/OpenRouter)
# NOTE: The file must exist on the host for the mount to succeed.
# If you don't need local overrides, you can skip this or create an empty file:
#   touch /path/to/claw-bedrock/config.local.yaml
# Volume=/path/to/claw-bedrock/config.local.yaml:/app/config.local.yaml:Z

[Install]
WantedBy=default.target
