[Unit]
Description=claw-bedrock

[Service]
Restart=on-failure
TimeoutStartSec=900
CPUQuota=50%

[Container]
# Pre-built image from GitHub Container Registry:
Image=ghcr.io/jeshii/claw-bedrock:latest
ContainerName=claw-bedrock
PublishPort=4000:4000
PublishPort=8282:8282

# Update these values:
Environment=AWS_PROFILE=your-profile
Environment=AWS_REGION=your-region
Environment=BEDROCK_MANTLE_API_BASE=https://bedrock-mantle.<region>.api.aws/v1
Environment=CONFIG_DIR=/config
# Encrypts provider API keys at rest. STRONGLY recommended: without it the app
# falls back to a deterministic dev key derived from a hardcoded password
# (src/encryption_utils.py), which is public in this source tree. Generate one:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Setting this later does NOT decrypt existing data — re-enter provider API keys.
# Environment=ENCRYPTION_KEY=  # preferred
# Secret=encryption_key,type=env,target=ENCRYPTION_KEY # the better way to set
# Environment=OPENROUTER_API_KEY=your-key  # optional
# Secret=openrouter_api_key,type=env,target=OPENROUTER_API_KEY # another way to set
# Environment=MANAGEMENT_PASSWORD=changeme # optional, no login screen if missing
# Secret=managment_password,type=env,target=MANAGEMENT_PASSWORD # the better way to set
# Environment=OLLAMA_API_BASE=http://your-ollama-host:11434  # optional

# IMPORTANT: ~/.aws must exist (run `aws configure` to create it)
Volume=%h/.aws:/root/.aws:Z

# Mount config directory for persistence (model configs survive container restarts):
# Create a local directory and mount it to /app:
#   mkdir -p %h/claw-bedrock-config
Volume=%h/claw-bedrock-config:/config:Z

[Install]
WantedBy=default.target
